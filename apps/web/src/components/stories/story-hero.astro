---
import type { Story } from "../../content/content-schema";
import { PATHS, featureLinksFor } from "../../content/catalog";
import { marketingFr } from "../../copy/marketing-fr";
import { storiesFr } from "../../copy/stories-fr";
import StoryCover from "./story-cover.astro";

interface Props {
  story: Story;
}

const { story } = Astro.props;
const features = featureLinksFor(story);
---

<section class="pt-6 pb-7 sm:pt-10 sm:pb-10">
  <div class="mx-auto flex max-w-270 flex-col gap-5 px-4 sm:px-6">
    <nav aria-label={marketingFr.breadcrumbLabel} class="text-[12.5px] text-slate-text">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href={PATHS.home} class="inline-flex min-h-8 items-center hover:text-navy">{marketingFr.breadcrumbHome}</a></li>
        <li aria-hidden="true">›</li>
        <li><a href={PATHS.stories} class="inline-flex min-h-8 items-center hover:text-navy">{storiesFr.eyebrow}</a></li>
      </ol>
    </nav>
    <div class="flex flex-wrap items-stretch gap-6 sm:gap-12">
      <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-4">
        <ul class="flex flex-wrap gap-1.5">
          <li class="rounded-full bg-validated-soft px-2.5 py-0.5 text-xs font-semibold text-validated">
            {story.card.activity}
          </li>
          {
            features.map((feature) => (
              <li class="rounded-full bg-hairline px-2.5 py-0.5 text-xs font-semibold">
                {feature.href ? (
                  <a href={feature.href} class="hover:text-validated">
                    {feature.title}
                  </a>
                ) : (
                  feature.title
                )}
              </li>
            ))
          }
        </ul>
        <h1 class="text-[29px] leading-[1.15] font-bold tracking-[-0.03em] text-balance sm:text-[38px]">
          {story.title}
        </h1>
        <p class="text-base leading-relaxed text-slate-text sm:text-[15px]">{story.lead}</p>
        <div class="flex items-center gap-3 pt-1">
          <span
            class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-navy font-bold text-white"
            aria-hidden="true">{story.character.initial}</span
          >
          <p class="flex flex-col">
            <span class="font-semibold">{story.character.name}</span>
            <span class="text-[12.5px] text-slate-text">
              {story.character.role} · {storiesFr.readingTime(story.card.minutes)}
            </span>
          </p>
        </div>
        <p
          class="flex items-start gap-2 rounded-lg border border-panel-line bg-panel px-2.5 py-2 text-[12.5px] text-slate-text"
        >
          <svg
            class="mt-0.75 size-3.5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg
          >
          {storiesFr.fictionNote}
        </p>
      </div>
      <StoryCover card={story.card} />
    </div>
  </div>
</section>
