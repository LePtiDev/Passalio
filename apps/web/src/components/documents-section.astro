---
import { fr } from "../fr";
import SectionHeading from "./section-heading.astro";

const { documents } = fr;
---

<section class="bg-navy py-[clamp(56px,8vw,104px)] text-white">
  <div class="mx-auto flex max-w-290 flex-wrap items-center gap-x-16 gap-y-10 px-5">
    <div class="min-w-0 flex-[1_1_400px]">
      <SectionHeading
        eyebrow={documents.eyebrow}
        title={documents.title}
        lead={documents.text}
        isOnNavy
      />
    </div>
    <ul class="grid min-w-0 flex-[1_1_420px] grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4">
      {
        documents.items.map((item) => (
          <li class="flex flex-col gap-2.5 rounded-2xl bg-white p-5 text-navy">
            <p class="text-xs font-bold tracking-[0.04em] text-validated uppercase">{item.kind}</p>
            <p class="text-lg font-extrabold">{item.title}</p>
            <ul class="flex list-disc flex-col gap-1 pl-4.5 text-sm text-slate-text">
              {item.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
