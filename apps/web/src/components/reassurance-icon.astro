---
interface Props {
  name: "offline" | "import" | "shield";
}

const { name } = Astro.props;
---

<span
  class="inline-flex size-8 items-center justify-center rounded-lg border border-panel-line bg-panel"
  aria-hidden="true"
>
  <svg
    class="size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {
      name === "offline" && (
        <>
          <path d="M2 2l20 20" />
          <path d="M8.5 16.5a5 5 0 017 0" />
          <path d="M5 12.9a10 10 0 015.2-2.8" />
          <path d="M19 12.9a10 10 0 00-2.3-1.6" />
          <path d="M12 20h.01" />
        </>
      )
    }
    {
      name === "import" && (
        <>
          <path d="M12 3v12" />
          <path d="M7 10l5 5 5-5" />
          <path d="M5 21h14" />
        </>
      )
    }
    {
      name === "shield" && (
        <>
          <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" />
          <path d="M9 12l2 2 4-4" />
        </>
      )
    }
  </svg>
</span>
