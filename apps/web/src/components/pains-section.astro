---
import { fr } from "../fr";
import SectionHeading from "./section-heading.astro";

const toNumber = (index: number): string => String(index + 1).padStart(2, "0");
---

<section class="border-t border-hairline py-[clamp(56px,7vw,96px)]">
  <div class="mx-auto flex max-w-270 flex-col gap-10 px-4 sm:px-6">
    <SectionHeading eyebrow={fr.pains.eyebrow} title={fr.pains.title} lead={fr.pains.lead} />
    <ol class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] border-t border-card-line">
      {
        fr.pains.items.map((item, index) => (
          <li class="flex flex-col gap-2 pt-5 pr-6 pb-2">
            <p class="flex items-baseline gap-2.5">
              <span class="text-xs font-semibold text-validated tabular-nums">{toNumber(index)}</span>
              <span class="text-[13px] font-semibold">{item.moment}</span>
            </p>
            <p class="text-[13px] leading-relaxed text-slate-text">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
