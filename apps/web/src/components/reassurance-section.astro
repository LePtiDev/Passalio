---
import { fr } from "../fr";
import ReassuranceIcon from "./reassurance-icon.astro";

const ICONS = ["offline", "import", "shield"] as const;
const items = fr.reassurance.map((item, index) => ({ ...item, icon: ICONS[index] ?? "shield" }));
---

<section class="border-t border-hairline py-[clamp(48px,6vw,80px)]">
  <ul
    class="mx-auto grid max-w-270 grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-x-10 gap-y-8 px-4 sm:px-6"
  >
    {
      items.map((item) => (
        <li class="flex flex-col gap-2.5">
          <ReassuranceIcon name={item.icon} />
          <h2 class="text-sm font-semibold">{item.title}</h2>
          <p class="text-[13px] leading-relaxed text-slate-text">{item.text}</p>
        </li>
      ))
    }
  </ul>
</section>
