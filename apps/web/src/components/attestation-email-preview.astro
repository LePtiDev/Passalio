---
import { fr } from "../fr";
import PreviewCard from "./preview-card.astro";

const step = fr.passage.leaving;
---

<PreviewCard class="gap-3">
  <p class="text-[13px] text-slate-text">{step.to}</p>
  <p class="text-[17px] font-bold">{step.subject}</p>
  <div class="flex items-center gap-3 rounded-xl border border-line px-3 py-2.5">
    <span
      class="inline-flex h-11 w-9 shrink-0 items-center justify-center rounded-md bg-mist text-[11px] font-extrabold text-pdf"
      aria-hidden="true">PDF</span
    >
    <div class="min-w-0">
      <p class="truncate text-sm font-semibold tabular-nums">{step.file}</p>
      <p class="text-[13px] text-slate-text">{step.signedOn}</p>
    </div>
  </div>
  <p class="flex items-center gap-2 text-sm font-semibold text-validated">
    <svg
      class="size-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="5" y="11" width="14" height="10" rx="2"></rect>
      <path d="M8 11V7a4 4 0 018 0v4"></path>
    </svg>
    <span>{step.locked}</span>
  </p>
</PreviewCard>
