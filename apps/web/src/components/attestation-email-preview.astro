---
import { fr } from "../fr";
import PreviewCard from "./preview-card.astro";

const step = fr.passage.leaving;
---

<PreviewCard class="gap-2.5">
  <p class="text-xs text-slate-text">{step.to}</p>
  <p class="text-sm font-semibold">{step.subject}</p>
  <div class="flex items-center gap-2.5 rounded-lg border border-card-line px-2.5 py-2">
    <span
      class="inline-flex h-8.5 w-7 shrink-0 items-center justify-center rounded bg-pdf-soft text-[9px] font-bold text-pdf"
      aria-hidden="true">PDF</span
    >
    <div class="min-w-0">
      <p class="truncate font-medium tabular-nums">{step.file}</p>
      <p class="text-xs text-slate-text">{step.signedOn}</p>
    </div>
  </div>
  <p class="flex items-center gap-1.5 text-xs font-semibold text-validated">
    <svg
      class="size-3.25"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="5" y="11" width="14" height="10" rx="2"></rect>
      <path d="M8 11V7a4 4 0 018 0v4"></path>
    </svg>
    <span>{step.locked}</span>
  </p>
</PreviewCard>
