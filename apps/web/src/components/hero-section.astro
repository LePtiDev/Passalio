---
import { fr } from "../fr";
import { appUrl } from "../links";
import ButtonLink from "./button-link.astro";
import CheckIcon from "./check-icon.astro";
import PhonePreview from "./phone-preview.astro";
---

<section id="haut" class="py-[clamp(48px,7vw,96px)]">
  <div
    class="mx-auto flex max-w-270 flex-wrap items-center gap-[clamp(40px,5vw,72px)] px-4 sm:px-6"
  >
    <div class="flex min-w-0 flex-[3_1_440px] flex-col items-start gap-5">
      <p
        class="inline-flex items-center gap-2 rounded-full bg-validated-soft py-0.75 pr-2.25 pl-1.75 text-[11px] font-semibold text-validated"
      >
        <span class="size-1.5 rounded-full bg-validated" aria-hidden="true"></span>
        {fr.hero.eyebrow}
      </p>
      <h1 class="text-[clamp(30px,3.5vw,44px)] leading-[1.08] font-bold tracking-[-0.035em]">
        {fr.hero.title}
      </h1>
      <p class="max-w-[32em] text-[15px] leading-relaxed text-slate-text">{fr.hero.lead}</p>
      <div class="flex flex-wrap gap-2.5 pt-1">
        <ButtonLink href={appUrl("signUp")}>{fr.hero.primary}</ButtonLink>
        <ButtonLink href="#passage" variant="outline">{fr.hero.secondary}</ButtonLink>
      </div>
      <ul class="flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-slate-text">
        {
          fr.hero.highlights.map((highlight) => (
            <li class="inline-flex items-center gap-1.5">
              <CheckIcon class="size-3.5 text-validated" />
              {highlight}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="min-w-0 flex-[2_1_340px]">
      <PhonePreview />
    </div>
  </div>
</section>
