---
import { fr } from "../fr";
import { type AppPage, appUrl } from "../links";

const links: ReadonlyArray<{ page: AppPage; label: string }> = [
  { page: "signIn", label: fr.footer.signIn },
  { page: "terms", label: fr.footer.terms },
  { page: "privacy", label: fr.footer.privacy },
  { page: "legalNotice", label: fr.footer.legalNotice },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline py-8">
  <div
    class="mx-auto flex max-w-270 flex-wrap items-center justify-between gap-x-8 gap-y-4 px-4 sm:px-6"
  >
    <div class="flex flex-wrap items-center gap-4">
      <img src="/passalio-logo.svg" alt={fr.brand} width="76" height="15" class="h-3.75 w-auto" />
      <p class="text-[13px] text-slate-text">{fr.footer.copyright(year)}</p>
    </div>
    <nav aria-label={fr.footer.label} class="flex flex-wrap gap-x-1 text-xs">
      {
        links.map((link) => (
          <a
            href={appUrl(link.page)}
            class="inline-flex min-h-12 items-center px-2.5 text-slate-text hover:text-navy"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
