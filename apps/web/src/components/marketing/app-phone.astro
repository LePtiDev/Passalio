---
import type { AppScreen } from "../../content/content-schema";
import { marketingFr } from "../../copy/marketing-fr";
import StatusPill from "./status-pill.astro";

interface Props {
  screen: AppScreen;
}

const { screen } = Astro.props;
---

<figure
  class="dot-grid m-0 flex min-w-0 flex-[1_1_380px] justify-center rounded-2xl border border-panel-line bg-panel py-6 sm:py-8"
  aria-label={marketingFr.screenLabel(screen.title)}
>
  <div
    class="flex aspect-[9/19.5] w-57.5 flex-col overflow-hidden rounded-[32px] border-6 border-navy bg-white shadow-phone sm:w-67.5 sm:rounded-[38px] sm:border-7"
  >
    <div class="flex h-5.5 items-center justify-center" aria-hidden="true">
      <span class="h-1.5 w-16 rounded-full bg-navy"></span>
    </div>
    <div class="flex items-center justify-between border-b border-hairline px-3.5 pt-1.5 pb-2.5">
      <span class="text-[11px] text-slate-text">‹ {screen.backLabel}</span>
      <StatusPill label={screen.status.label} tone={screen.status.tone} class="text-[10px]" />
    </div>
    <div class="flex min-h-0 flex-1 flex-col gap-2.25 px-3.5 py-3">
      <div>
        <p class="text-[15px] leading-snug font-bold">{screen.title}</p>
        <p class="text-[11px] text-slate-text">{screen.subtitle}</p>
      </div>
      <ul class="flex flex-col gap-2.25">
        {
          screen.rows.map((row) => (
            <li class="flex items-center justify-between gap-2 rounded-[10px] border border-card-line px-2.5 py-2">
              <span class="min-w-0">
                <span class="block text-xs leading-snug font-semibold">{row.label}</span>
                <span class="block text-[10.5px] leading-snug text-slate-text">{row.value}</span>
              </span>
              {row.tag && (
                <span class="shrink-0 rounded-full bg-hairline px-1.75 py-0.5 text-[9.5px] font-semibold">
                  {row.tag}
                </span>
              )}
            </li>
          ))
        }
      </ul>
      <span class="flex-1"></span>
      <p
        class="mb-1.5 flex h-9.5 items-center justify-center rounded-[9px] bg-navy text-xs font-semibold text-white"
      >
        {screen.action}
      </p>
    </div>
  </div>
</figure>
