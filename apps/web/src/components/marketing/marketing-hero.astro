---
import type { MarketingPage } from "../../content/content-schema";
import { marketingFr } from "../../copy/marketing-fr";
import { appUrl } from "../../links";
import ButtonLink from "../button-link.astro";
import CheckIcon from "../check-icon.astro";
import AppPhone from "./app-phone.astro";

interface Props {
  page: MarketingPage;
}

const { page } = Astro.props;
---

<section class="py-8 sm:py-16">
  <div class="mx-auto flex max-w-270 flex-wrap items-center gap-6 px-4 sm:gap-14 sm:px-6">
    <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-4.5">
      <p
        class="self-start rounded-full bg-validated-soft px-2.5 py-0.5 text-xs font-semibold text-validated"
      >
        {page.eyebrow}
      </p>
      <h1
        class="text-[31px] leading-[1.12] font-bold tracking-[-0.03em] text-balance sm:text-[44px]"
      >
        {page.title}
      </h1>
      <p class="max-w-120 text-base leading-relaxed text-slate-text sm:text-[15px]">{page.lead}</p>
      <div class="flex flex-col gap-2 sm:flex-row">
        <ButtonLink href={appUrl("signUp")}>{marketingFr.tryFree}</ButtonLink>
        <ButtonLink href="#rappel" variant="outline">{marketingFr.callMeBack}</ButtonLink>
      </div>
      <ul class="flex flex-wrap gap-x-3.5 gap-y-1 text-xs text-slate-text">
        {
          page.highlights.map((highlight) => (
            <li class="inline-flex items-center gap-1.25">
              <CheckIcon class="size-3.25 text-validated" />
              {highlight}
            </li>
          ))
        }
      </ul>
    </div>
    <AppPhone screen={page.screen} />
  </div>
</section>
