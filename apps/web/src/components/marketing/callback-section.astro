---
import { callbackFormFr } from "../../copy/callback-form-fr";
import CallbackForm from "./callback-form.astro";

interface Props {
  title: string;
  lead: string;
  pagePath: string;
  eyebrow?: string;
  note?: string;
}

const { title, lead, pagePath, eyebrow, note } = Astro.props;
---

<section id="rappel" class="scroll-mt-4 border-t border-panel-line bg-panel py-10 sm:py-18">
  <div class="mx-auto flex max-w-270 flex-wrap items-start gap-6 px-4 sm:gap-14 sm:px-6">
    <div class="flex min-w-0 flex-[1_1_380px] flex-col gap-3.5">
      {
        eyebrow && (
          <p class="text-[11px] font-semibold tracking-[0.08em] text-validated uppercase">{eyebrow}</p>
        )
      }
      <h2 class="text-[23px] leading-tight font-bold tracking-[-0.02em] text-balance sm:text-[27px]">
        {title}
      </h2>
      <p class="text-base text-slate-text sm:text-[15px]">{lead}</p>
      <div class="flex items-center gap-3">
        <span
          class="inline-flex size-10 items-center justify-center rounded-full bg-navy font-bold text-white"
          aria-hidden="true">A</span
        >
        <p class="flex flex-col">
          <span class="font-semibold">{callbackFormFr.contactName}</span>
          <span class="text-xs text-slate-text">{callbackFormFr.contactRole}</span>
        </p>
      </div>
      {note && <p class="text-[13px] text-slate-text">{note}</p>}
    </div>
    <CallbackForm pagePath={pagePath} />
  </div>
</section>
