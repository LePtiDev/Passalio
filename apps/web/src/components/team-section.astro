---
import { fr } from "../fr";
import SectionHeading from "./section-heading.astro";

const { team } = fr;
---

<section class="py-[clamp(56px,8vw,104px)]">
  <div class="mx-auto flex max-w-290 flex-wrap items-center gap-x-16 gap-y-10 px-5">
    <div class="min-w-0 flex-[1_1_400px]">
      <SectionHeading eyebrow={team.eyebrow} title={team.title} lead={team.lead} />
    </div>
    <div class="min-w-0 flex-[1_1_420px] overflow-hidden rounded-2xl border border-line bg-white">
      <div class="flex justify-between gap-3 border-b border-line px-5 py-3.5 font-bold">
        <span>{team.today}</span>
        <span class="font-semibold text-slate-text tabular-nums">{team.date}</span>
      </div>
      <ul>
        {
          team.members.map((member) => (
            <li class="flex items-center justify-between gap-3 border-b border-line px-5 py-3.5 last:border-b-0">
              <div>
                <p class="font-semibold">{member.name}</p>
                <p class="text-sm text-slate-text">{member.activity}</p>
              </div>
              <span
                class:list={[
                  "rounded-full px-2.5 py-1 text-xs font-bold",
                  member.isOwner ? "bg-validated-soft text-validated" : "bg-mist text-navy",
                ]}
              >
                {member.role}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
