---
import { noNetworkCampaign } from "../../content/campaigns/no-network";
import SectionHeading from "../section-heading.astro";

const { comparison, steps } = noNetworkCampaign;
---

<section class="border-t border-hairline py-10 sm:py-18">
  <div class="mx-auto flex max-w-270 flex-col gap-7 px-4 sm:px-6">
    <SectionHeading eyebrow={comparison.eyebrow} title={comparison.title} />
    <div class="overflow-hidden rounded-xl border border-card-line">
      <table class="w-full border-collapse text-left text-sm">
        <thead class="hidden bg-row-head sm:table-header-group">
          <tr>
            {
              comparison.headers.map((header) => (
                <th scope="col" class="px-4 py-3 text-xs font-semibold text-slate-text">
                  {header}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            comparison.rows.map(([need, before, after]) => (
              <tr class="flex flex-col border-t border-hairline px-4 py-3 first:border-t-0 sm:table-row sm:p-0 sm:first:border-t">
                <th scope="row" class="py-0.5 font-semibold sm:px-4 sm:py-3">
                  {need}
                </th>
                <td class="py-0.5 text-slate-text sm:px-4 sm:py-3">
                  <span class="text-xs font-semibold sm:hidden">{comparison.headers[1]} : </span>
                  {before}
                </td>
                <td class="py-0.5 font-medium text-validated sm:px-4 sm:py-3">
                  <span class="text-xs font-semibold sm:hidden">{comparison.headers[2]} : </span>
                  {after}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<section id="comment" class="scroll-mt-4 border-y border-panel-line bg-panel py-10 sm:py-18">
  <div class="mx-auto flex max-w-270 flex-col gap-8 px-4 sm:px-6">
    <SectionHeading eyebrow={steps.eyebrow} title={steps.title} />
    <ol class="grid gap-4 sm:grid-cols-3">
      {
        steps.items.map((step, index) => (
          <li class="flex flex-col gap-2 rounded-xl border border-card-line bg-white p-5">
            <span class="text-xs font-bold text-validated">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="text-base font-bold">{step.title}</h3>
            <p class="text-slate-text">{step.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="flex flex-col gap-4 sm:flex-row sm:gap-10">
      <div class="flex flex-col gap-2">
        <p class="text-xs font-semibold text-validated">{steps.availableLabel}</p>
        <ul class="flex flex-wrap gap-1.5">
          {
            steps.available.map((item) => (
              <li class="rounded-full bg-validated-soft px-2.5 py-1 text-xs font-semibold text-validated">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-col gap-2">
        <p class="text-xs font-semibold text-amber-text">{steps.upcomingLabel}</p>
        <ul class="flex flex-wrap gap-1.5">
          {
            steps.upcoming.map((item) => (
              <li class="rounded-full bg-amber-soft px-2.5 py-1 text-xs font-semibold text-amber-text">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
