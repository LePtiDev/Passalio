    className,
  ]}
>
  <svg
    class="size-[15px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"><path d={PATHS[icon]}></path></svg
