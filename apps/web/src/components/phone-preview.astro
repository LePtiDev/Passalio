---
import { fr } from "../fr";
import CheckIcon from "./check-icon.astro";

const phone = fr.hero.phone;
---

<figure
  class="dot-grid relative m-0 flex justify-center rounded-2xl border border-panel-line bg-panel px-6 pt-8 pb-13"
  aria-label={phone.label}
>
  <div class="w-57 overflow-hidden rounded-[34px] border-6 border-navy bg-white shadow-phone">
    <div class="flex flex-col gap-2.75 px-3.5 pt-4.5 pb-4 text-xs leading-snug">
      <div class="flex items-center gap-1.5 text-[11px] font-medium text-slate-text">
        <svg
          class="size-3"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg
        >
        <span>{phone.customer}</span>
      </div>
      <p class="text-[15px] font-bold tracking-[-0.01em]">{phone.title}</p>
      <div class="rounded-lg border border-panel-line bg-panel px-2.5 py-2">
        <p class="text-[10px] font-semibold tracking-[0.06em] text-slate-text uppercase">
          {phone.flueLabel}
        </p>
        <p class="font-semibold">{phone.flue}</p>
        <p class="text-[11px] text-slate-text">{phone.flueDetail}</p>
      </div>
      <ul class="flex flex-col gap-1.75">
        {
          phone.checks.map((check) => (
            <li class="flex items-center gap-2">
              <span class="inline-flex size-4 shrink-0 items-center justify-center rounded bg-validated">
                <CheckIcon class="size-2.5 text-white" />
              </span>
              <span>{check}</span>
            </li>
          ))
        }
      </ul>
      <div>
        <p class="mb-1 text-[10px] font-semibold tracking-[0.06em] text-slate-text uppercase">
          {phone.signature}
        </p>
        <div class="flex h-16 items-center justify-center rounded-lg border border-dashed border-input">
          <svg
            width="130"
            height="40"
            viewBox="0 0 170 56"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M6 38c10-22 18-30 22-24s-8 30-2 28 14-26 20-24-2 22 4 22 10-16 16-16 2 14 8 14 12-12 18-12 6 8 12 8 14-6 22-10 18-4 28-6"
            ></path>
          </svg>
        </div>
      </div>
      <p class="flex h-9 items-center justify-center rounded-lg bg-navy font-semibold text-white">
        {phone.submit}
      </p>
    </div>
  </div>
  <figcaption
    class="absolute inset-x-4 bottom-4 mx-auto flex max-w-75 items-center gap-2.5 rounded-xl border border-card-line bg-white px-3 py-2.5 shadow-card"
  >
    <span class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-validated-soft">
      <CheckIcon class="size-3.25 text-validated" />
    </span>
    <span class="text-xs leading-snug">
      <strong class="font-semibold">{fr.hero.toastTitle}</strong>
      <br />
      <span class="text-slate-text">{fr.hero.toastText}</span>
    </span>
  </figcaption>
</figure>
