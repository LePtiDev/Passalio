---
import { fr } from "../fr";
import CheckIcon from "./check-icon.astro";

const phone = fr.hero.phone;
---

<figure class="relative m-0 w-75 max-w-full" aria-label={phone.label}>
  <div
    class="overflow-hidden rounded-[44px] border-10 border-navy bg-white shadow-[0_30px_60px_-30px_rgba(15,42,68,0.45)]"
  >
    <div class="flex flex-col gap-3.5 px-4.5 pt-5.5 pb-5 text-sm">
      <div class="flex items-center gap-2 text-[13px] font-semibold text-slate-text">
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg
        >
        <span>{phone.customer}</span>
      </div>
      <p class="text-[19px] leading-tight font-extrabold">{phone.title}</p>
      <div class="rounded-xl bg-mist px-3.5 py-3">
        <p class="text-xs font-semibold text-slate-text">{phone.flueLabel}</p>
        <p class="font-bold">{phone.flue}</p>
        <p class="text-[13px] text-slate-text">{phone.flueDetail}</p>
      </div>
      <ul class="flex flex-col gap-2">
        {
          phone.checks.map((check) => (
            <li class="flex items-center gap-2.5">
              <span class="inline-flex size-5.5 shrink-0 items-center justify-center rounded-md bg-validated">
                <CheckIcon />
              </span>
              <span>{check}</span>
            </li>
          ))
        }
      </ul>
      <div>
        <p class="mb-1.5 text-xs font-semibold text-slate-text">{phone.signature}</p>
        <div class="flex h-21 items-center justify-center rounded-xl border border-dashed border-input">
          <svg
            width="170"
            height="56"
            viewBox="0 0 170 56"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M6 38c10-22 18-30 22-24s-8 30-2 28 14-26 20-24-2 22 4 22 10-16 16-16 2 14 8 14 12-12 18-12 6 8 12 8 14-6 22-10 18-4 28-6"
            ></path>
          </svg>
        </div>
      </div>
      <p class="flex min-h-12 items-center justify-center rounded-xl bg-navy font-bold text-white">
        {phone.submit}
      </p>
    </div>
  </div>
  <figcaption
    class="absolute -right-5 -bottom-8.5 -left-9 flex items-start gap-3 rounded-2xl border border-line bg-white px-4 py-3.5 shadow-[0_16px_40px_-16px_rgba(15,42,68,0.35)]"
  >
    <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-validated-soft">
      <CheckIcon class="size-4 text-validated" />
    </span>
    <span class="text-sm leading-snug">
      <strong>{fr.hero.toastTitle}</strong>
      <br />
      <span class="text-slate-text">{fr.hero.toastText}</span>
    </span>
  </figcaption>
</figure>
