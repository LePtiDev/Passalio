---
import { fr } from "../fr";

interface Props {
  number: number;
  title: string;
  text: string;
  isLast?: boolean;
}

const { number, title, text, isLast = false } = Astro.props;
---

<li class="flex flex-wrap items-center gap-x-16 gap-y-6">
  <div class="flex max-w-110 min-w-0 flex-[1_1_360px] flex-col gap-2">
    <p
      class:list={[
        "text-xs font-semibold tracking-[0.06em] uppercase tabular-nums",
        isLast ? "text-validated" : "text-slate-text",
      ]}
    >
      {fr.passage.step(number)}
    </p>
    <h3 class="text-base leading-snug font-semibold tracking-[-0.01em]">{title}</h3>
    <p class="leading-relaxed text-slate-text">{text}</p>
  </div>
  <div class="min-w-0 flex-[1_1_360px]">
    <slot />
  </div>
</li>
