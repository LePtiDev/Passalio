---
interface Props {
  href: string;
  variant?: "primary" | "outline";
}

const { href, variant = "primary" } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex h-12 items-center justify-center gap-1.5 rounded-md px-4.5 text-[15px] font-semibold whitespace-nowrap sm:h-8 sm:px-3 sm:text-[13px]",
    variant === "primary" && "bg-navy text-white shadow-button hover:bg-navy-hover",
    variant === "outline" &&
      "border border-line bg-white text-navy shadow-[0_1px_2px_rgb(15_42_68/0.05)] hover:border-input",
  ]}
>
  <slot />
</a>
