---
import { homeFr } from "../../copy/home-fr";
import CheckIcon from "../check-icon.astro";

type Visit = NonNullable<(typeof homeFr.visual.technicians)[number]["visits"][number]>;

const visual = homeFr.visual;
const VISIT_STYLES: Readonly<Record<Visit["state"], string>> = {
  confirmed: "border-validated bg-validated-soft",
  pending: "border-sun bg-amber-soft",
  planned: "border-navy bg-mist",
};
const placeClass = (visit: Visit): string =>
  visit.state === "pending" ? "text-amber-text" : "text-slate-text";
const dayClass = (index: number): string => (index === 3 ? "hidden lg:block" : "");
---

<div class="relative" role="img" aria-label={visual.label}>
  <div
    class="dot-grid h-124 rounded-2xl border border-panel-line bg-panel sm:hidden"></div>
  <div
    class="hidden overflow-hidden rounded-t-xl border border-b-0 border-card-line bg-white shadow-window sm:block"
   
  >
    <div class="flex h-8 items-center gap-1.5 border-b border-hairline bg-section px-3">
      <span class="size-2.5 rounded-full bg-line"></span>
      <span class="size-2.5 rounded-full bg-line"></span>
      <span class="size-2.5 rounded-full bg-line"></span>
      <span
        class="mx-auto rounded-md border border-hairline bg-white px-10 py-0.5 text-[11px] text-slate-text"
      >
        {visual.address}
      </span>
    </div>
    <div class="flex text-xs">
      <div class="flex w-44 shrink-0 flex-col gap-0.5 border-r border-hairline bg-section p-3">
        <p class="mb-2 px-2 text-[13px] font-bold">{visual.company}</p>
        {
          visual.navigation.map((entry) => (
            <span
              class:list={[
                "rounded-md px-2 py-1.5",
                entry === visual.currentNavigation
                  ? "bg-white font-semibold shadow-card"
                  : "text-slate-text",
              ]}
            >
              {entry}
            </span>
          ))
        }
      </div>
      <div class="min-w-0 flex-1 p-4 pr-60 lg:pr-64">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-[15px] font-bold">{visual.week}</p>
            <p class="text-[11px] text-slate-text">{visual.weekSummary}</p>
          </div>
          <div class="flex gap-1">
            <span class="rounded-md border border-card-line px-2 py-1">{visual.dayView}</span>
            <span class="rounded-md bg-navy px-2 py-1 text-white">{visual.weekView}</span>
          </div>
        </div>
        <div
          class="mt-3 grid grid-cols-[64px_repeat(3,minmax(0,1fr))] gap-1.5 lg:grid-cols-[80px_repeat(4,minmax(0,1fr))]"
        >
          <span></span>
          {
            visual.days.map((day, index) => (
              <span class:list={["text-center font-semibold", dayClass(index)]}>{day}</span>
            ))
          }
          {
            visual.technicians.map((technician) => (
              <>
                <span class="pt-1 text-slate-text">{technician.name}</span>
                {technician.visits.map((visit, index) =>
                  visit ? (
                    <span
                      class:list={[
                        "rounded-md border-l-3 px-1.5 py-1",
                        VISIT_STYLES[visit.state],
                        dayClass(index),
                      ]}
                    >
                      <b class="font-semibold">
                        {visit.time} · {visit.customer}
                      </b>
                      <br />
                      <span class={placeClass(visit)}>{visit.place}</span>
                    </span>
                  ) : (
                    <span class:list={["rounded-md border border-dashed border-line", dayClass(index)]} />
                  ),
                )}
              </>
            ))
          }
        </div>
      </div>
    </div>
    <div class="h-28"></div>
  </div>

  <div
    class="absolute top-6 left-1/2 w-52 -translate-x-1/2 overflow-hidden rounded-[30px] border-5 border-navy bg-white shadow-phone sm:top-12 sm:right-10 sm:left-auto sm:translate-x-0"
    style="aspect-ratio: 9 / 19.5"
   
  >
    <div class="flex flex-col gap-2 px-3 pt-4 text-[11px] leading-snug">
      <div class="flex items-center justify-between text-slate-text">
        <span>‹ {visual.phone.back}</span>
        <span class="rounded-full bg-amber-soft px-1.5 py-0.5 font-semibold text-amber-text">
          ● {visual.phone.status}
        </span>
      </div>
      <p class="text-[15px] font-bold">{visual.phone.customer}</p>
      <p class="text-slate-text">{visual.phone.address}</p>
      <div class="grid grid-cols-2 gap-1.5">
        {
          visual.phone.fields.map((field) => (
            <div class="rounded-md border border-panel-line bg-panel p-1.5">
              <p class="text-slate-text">{field.label}</p>
              <p class="font-bold">{field.value}</p>
            </div>
          ))
        }
      </div>
      {
        visual.phone.details.map((detail) => (
          <div class="rounded-md border border-panel-line p-1.5">
            <p class="text-slate-text">{detail.label}</p>
            <p class="font-semibold">{detail.value}</p>
          </div>
        ))
      }
      <p class="rounded-md bg-amber-soft p-1.5 text-amber-text">{visual.phone.pending}</p>
    </div>
  </div>

  <div
    class="absolute bottom-3 left-3 flex items-center gap-2.5 rounded-xl border border-card-line bg-white px-3 py-2.5 shadow-card sm:top-72 sm:bottom-auto sm:-left-4"
   
  >
    <span class="inline-flex size-7 items-center justify-center rounded-full bg-validated-soft">
      <CheckIcon class="size-3.5 text-validated" />
    </span>
    <span class="text-xs leading-snug">
      <b class="font-semibold">{visual.confirmedTitle}</b>
      <br />
      <span class="text-slate-text">{visual.confirmedText}</span>
    </span>
  </div>
  <div
    class="absolute bottom-8 left-56 hidden items-center gap-2.5 rounded-xl border border-card-line bg-white px-3 py-2.5 shadow-card lg:flex"
   
  >
    <span class="inline-flex size-7 items-center justify-center rounded-full bg-mist">
      <svg
        class="size-3.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M12 20h.01"></path>
      </svg>
    </span>
    <span class="text-xs leading-snug">
      <b class="font-semibold">{visual.syncedTitle}</b>
      <br />
      <span class="text-slate-text">{visual.syncedText}</span>
    </span>
  </div>
</div>
