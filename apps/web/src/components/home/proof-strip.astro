---
import { homeFr } from "../../copy/home-fr";
---

<section class="border-y border-hairline bg-section">
  <ul class="mx-auto grid max-w-270 grid-cols-2 gap-x-4 gap-y-5 px-4 py-7 sm:grid-cols-4 sm:px-6">
    {
      homeFr.proofs.map((proof) => (
        <li class="flex flex-col gap-0.5">
          <p class="text-[20px] font-extrabold tracking-tight sm:text-[22px]">{proof.title}</p>
          <p class="text-[13px] text-slate-text sm:text-xs">{proof.text}</p>
        </li>
      ))
    }
  </ul>
</section>
