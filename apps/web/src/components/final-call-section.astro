---
import { fr } from "../fr";
import { appUrl } from "../links";
import ButtonLink from "./button-link.astro";
---

<section class="pb-[clamp(56px,7vw,96px)]">
  <div class="mx-auto max-w-270 px-4 sm:px-6">
    <div
      class="flex flex-wrap items-center justify-between gap-x-8 gap-y-5 rounded-2xl border border-panel-line bg-panel p-[clamp(24px,5vw,48px)]"
    >
      <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-2">
        <h2 class="text-[clamp(19px,1.9vw,22px)] leading-tight font-bold tracking-[-0.02em]">
          {fr.finalCall.title}
        </h2>
        <p class="text-slate-text">{fr.finalCall.lead}</p>
      </div>
      <ButtonLink href={appUrl("signUp")}>{fr.finalCall.action}</ButtonLink>
    </div>
  </div>
</section>
