---
import { fr } from "../fr";
import PreviewCard from "./preview-card.astro";

const step = fr.passage.before;
---

<PreviewCard class="gap-3.5">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-[17px] font-bold">{step.customer}</p>
      <p class="text-sm text-slate-text">{step.address}</p>
    </div>
    <span
      class="rounded-full bg-warning-soft px-2.5 py-1 text-xs font-bold whitespace-nowrap text-warning-strong"
    >
      {step.offline}
    </span>
  </div>
  <dl class="grid grid-cols-2 gap-3 border-t border-line pt-3 text-sm">
    {
      step.fields.map((field) => (
        <div>
          <dt class="text-slate-text">{field.label}</dt>
          <dd class="font-semibold tabular-nums">{field.value}</dd>
        </div>
      ))
    }
  </dl>
</PreviewCard>
