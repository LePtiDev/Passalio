---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  isOnNavy?: boolean;
}

const { eyebrow, title, lead, isOnNavy = false } = Astro.props;
---

<div class="flex max-w-155 flex-col gap-3">
  {
    eyebrow && (
      <p
        class:list={[
          "text-[11px] font-semibold tracking-[0.08em] uppercase",
          isOnNavy ? "text-mint" : "text-validated",
        ]}
      >
        {eyebrow}
      </p>
    )
  }
  <h2
    class:list={[
      "text-[clamp(21px,2.2vw,27px)] leading-tight font-bold tracking-[-0.02em] text-balance",
      isOnNavy && "text-white",
    ]}
  >
    {title}
  </h2>
  {
    lead && (
      <p class:list={["text-[15px] leading-relaxed", isOnNavy ? "text-on-navy" : "text-slate-text"]}>
        {lead}
      </p>
    )
  }
</div>
