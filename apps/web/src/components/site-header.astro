---
import { fr } from "../fr";
import { appUrl } from "../links";
---

<header class="border-b border-line bg-white">
  <div
    class="mx-auto flex min-h-18 max-w-290 flex-wrap items-center justify-between gap-x-4 gap-y-2 px-5 py-2"
  >
    <a href="#haut" class="flex min-h-12 items-center">
      <img src="/passalio-logo.svg" alt={fr.brand} width="142" height="28" class="h-7 w-auto" />
    </a>
    <nav aria-label={fr.nav.label} class="flex flex-wrap items-center gap-1 sm:gap-2">
      <a
        href="#passage"
        class="hidden min-h-12 items-center px-2.5 text-[15px] font-semibold text-slate-text hover:text-navy md:inline-flex"
      >
        {fr.nav.passage}
      </a>
      <a
        href="#questions"
        class="hidden min-h-12 items-center px-2.5 text-[15px] font-semibold text-slate-text hover:text-navy md:inline-flex"
      >
        {fr.nav.questions}
      </a>
      <a
        href={appUrl("signIn")}
        class="inline-flex min-h-12 items-center px-2.5 text-[15px] font-bold text-navy hover:text-validated"
      >
        {fr.nav.signIn}
      </a>
      <a
        href={appUrl("signUp")}
        class="hidden min-h-12 items-center rounded-xl bg-navy px-4.5 text-[15px] font-bold text-white hover:bg-navy-hover sm:inline-flex"
      >
        {fr.nav.tryFree}
      </a>
    </nav>
  </div>
</header>
