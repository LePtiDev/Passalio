---
import { fr } from "../fr";
import { appUrl } from "../links";
---

<header class="border-b border-hairline bg-white/90">
  <div class="mx-auto flex h-14 max-w-270 items-center justify-between gap-4 px-4 sm:h-13 sm:px-6">
    <a href="#haut" class="flex min-h-12 items-center">
      <img src="/passalio-logo.svg" alt={fr.brand} width="86" height="17" class="h-4.25 w-auto" />
    </a>
    <nav aria-label={fr.nav.label} class="flex items-center gap-1">
      <a
        href="#passage"
        class="hidden rounded-md px-2.5 py-1.5 text-[13px] font-medium text-slate-text hover:text-navy md:inline-flex"
      >
        {fr.nav.passage}
      </a>
      <a
        href="#questions"
        class="hidden rounded-md px-2.5 py-1.5 text-[13px] font-medium text-slate-text hover:text-navy md:inline-flex"
      >
        {fr.nav.questions}
      </a>
      <a
        href={appUrl("signIn")}
        class="inline-flex min-h-12 items-center px-2.5 text-sm font-medium text-navy hover:text-validated sm:min-h-0 sm:py-1.5 sm:text-[13px]"
      >
        {fr.nav.signIn}
      </a>
      <a
        href={appUrl("signUp")}
        class="ml-1 hidden h-7 items-center rounded-md bg-navy px-2.5 text-xs font-semibold text-white shadow-button hover:bg-navy-hover sm:inline-flex"
      >
        {fr.nav.tryFree}
      </a>
    </nav>
  </div>
</header>
