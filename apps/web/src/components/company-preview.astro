---
import { fr } from "../fr";
import PreviewCard from "./preview-card.astro";

const step = fr.passage.onSite;
---

<PreviewCard class="gap-3">
  <p class="text-xs font-bold tracking-[0.04em] text-slate-text uppercase">{step.heading}</p>
  <dl class="flex flex-col gap-2 text-[15px]">
    {
      step.fields.map((field) => (
        <div class="flex justify-between gap-3">
          <dt class="text-slate-text">{field.label}</dt>
          <dd class="text-right font-semibold tabular-nums">{field.value}</dd>
        </div>
      ))
    }
  </dl>
  <p class="flex items-start gap-2 rounded-[10px] bg-warning-soft px-3 py-2.5 text-sm text-warning-strong">
    <svg
      class="mt-0.5 size-4.5 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 9v4M12 17h.01"></path>
      <path d="M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"></path>
    </svg>
    <span>{step.warning}</span>
  </p>
</PreviewCard>
