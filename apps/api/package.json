{
  "name": "@passalio/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc && tsc -p tsconfig.scripts.json && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "release": "node scripts/release.ts",
    "platform:role": "node scripts/platform-role.ts",
    "prospects:import": "node scripts/prospects-import.ts",
    "mcp:revoke": "node scripts/mcp-revoke.ts",
    "plate-reading:eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/mistral": "4.0.62",
    "@ai-sdk/openai": "4.0.91",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@passalio/db": "workspace:*",
    "@passalio/emails": "workspace:*",
    "@passalio/shared": "workspace:*",
    "@passalio/trades": "workspace:*",
    "ai": "7.0.137",
    "better-auth": "1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "wrangler": "^4.151.3"
  }
}
