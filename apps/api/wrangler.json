{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "passalio-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passalio-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "passalio-local-files"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:5173",
    "APP_URL": "http://localhost:5173",
    "EMAIL_DELIVERY": "log",
    "EMAIL_FROM": "Passalio <ne-pas-repondre@passalio.com>",
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
  },
  "env": {
    "staging": {
      "name": "passalio-api-staging",
      "assets": {
        "directory": "../app/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/health"]
      },
      "routes": [{ "pattern": "app.staging.passalio.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "passalio-staging",
          "database_id": "ca093890-20f6-4ca9-a1be-3d7ccf75683c",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "passalio-staging-files",
          "jurisdiction": "eu"
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://app.staging.passalio.com",
        "APP_URL": "https://app.staging.passalio.com",
        "EMAIL_DELIVERY": "resend",
        "EMAIL_FROM": "Passalio <ne-pas-repondre@passalio.com>"
      }
    },
    "production": {
      "name": "passalio-api",
      "assets": {
        "directory": "../app/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/health"]
      },
      "routes": [{ "pattern": "app.passalio.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "passalio-production",
          "database_id": "99b939a8-4f72-44f8-a4ea-73528428ce0e",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "passalio-production-files",
          "jurisdiction": "eu"
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://app.passalio.com",
        "APP_URL": "https://app.passalio.com",
        "EMAIL_DELIVERY": "resend",
        "EMAIL_FROM": "Passalio <ne-pas-repondre@passalio.com>"
      }
    }
  }
}
