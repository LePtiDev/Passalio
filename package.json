{
  "name": "passalio",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @passalio/db db:generate",
    "db:migrate:local": "pnpm --filter @passalio/api db:migrate:local",
    "release:staging": "pnpm --filter @passalio/api release staging",
    "release:prod": "pnpm --filter @passalio/api release production",
    "test:e2e": "pnpm --filter @passalio/app test:e2e",
    "platform:grant": "pnpm --filter @passalio/api platform:role grant",
    "platform:revoke": "pnpm --filter @passalio/api platform:role revoke"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0"
}
